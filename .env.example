# ==================================================
# JIRA — GENERAL CONFIGURATION
# ==================================================
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_CLOUD_ID=your-atlassian-cloud-id
JIRA_AUTH_EMAIL=qa@example.com

# ==================================================
# JIRA — READ ACCESS
# ==================================================
JIRA_READ_API_TOKEN=

# ==================================================
# JIRA — COMMENT PUBLISHING (DISABLED BY DEFAULT)
# ==================================================
JIRA_PUBLISH_API_TOKEN=
# Scoped Atlassian API tokens use Basic authentication with JIRA_AUTH_EMAIL.
# This value must belong to that same Atlassian account; it is never replaced by JIRA_READ_API_TOKEN.
# Auto-QA's permission preflight also requires the Jira permission-read scope.
QA_JIRA_PUBLISH_ENABLED=false
QA_JIRA_REQUIRE_APPROVAL=true

# ==================================================
# GITHUB — READ ACCESS
# ==================================================
GITHUB_READ_API_TOKEN=

# ==================================================
# JIRA / GITHUB — PULL REQUEST DISCOVERY
# ==================================================
JIRA_PULL_REQUEST_FIELD_IDS=customfield_10113
GITHUB_REPOSITORY_ALIASES=alias-repo=org-name/repo-name,another-alias=org-name/another-repo

# ==================================================
# AUTO-QA — REPORT CONFIGURATION
# ==================================================
QA_REPORT_LANGUAGE=es
QA_LOG_LEVEL=info
QA_LOG_FORMAT=pretty

# ==================================================
# AUTO-QA — JIRA WEBHOOK RECEIVER
# ==================================================
QA_WEBHOOK_ENABLED=false
QA_WEBHOOK_HOST=127.0.0.1
QA_WEBHOOK_PORT=3100
QA_WEBHOOK_SECRET=
# Optional and separate from HMAC, for Jira Automation bearer authentication.
QA_WEBHOOK_AUTOMATION_SECRET=
QA_WEBHOOK_MODE=debug
QA_WEBHOOK_PUBLISH_PLANS=false
QA_TRIGGER_PROJECT_KEY=AGSVK
QA_TRIGGER_STATUS=Por revisar
# Comma-separated Jira account IDs. The legacy singular variable is also supported.
QA_TRIGGER_ASSIGNEE_ACCOUNT_IDS=
QA_COMMAND_ALLOWED_ACCOUNT_IDS=
QA_EXECUTION_DB_PATH=./data/auto-qa.sqlite
