JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_CLOUD_ID=your-atlassian-cloud-id
JIRA_EMAIL=qa@example.com
JIRA_API_TOKEN=your-scoped-jira-api-token
# Optional; required only to inspect private GitHub pull requests.
GITHUB_TOKEN=
# Optional comma-separated Jira field IDs that contain PR references.
JIRA_PULL_REQUEST_FIELD_IDS=
# Optional alias mapping: alias=owner/repository, separated by commas.
GITHUB_REPOSITORY_ALIASES=
